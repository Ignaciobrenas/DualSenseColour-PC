# Sony PlayStation 5 DualSense & DualSense Edge HID access rules for SenseHue
# Allows non-root desktop users (including Ubuntu Wayland and SteamOS Deck) to customize
# the RGB lightbar, player LEDs, telemetry, and microphone indicator over both USB-C and Bluetooth.

# DualSense (CFI-ZCT1W) - USB & hidraw
SUBSYSTEM=="usb", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:0CE6*", MODE="0660", TAG+="uaccess"

# DualSense Edge (CFI-ZCP1) - USB & hidraw
SUBSYSTEM=="usb", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:0DF2*", MODE="0660", TAG+="uaccess"
