{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SenseHue",
  "version": "3.0.0",
  "identifier": "com.sensehue.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SenseHue",
        "width": 440,
        "height": 680,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Ignacio Breñas",
    "copyright": "Copyright © 2026 Ignacio Breñas. MIT License.",
    "license": "MIT",
    "licenseFile": "../TERMS_AND_CONDITIONS.txt",
    "shortDescription": "SenseHue — DualSense & DualSense Edge RGB Lighting, Battery Telemetry & Effects.",
    "longDescription": "Fast, lightweight native desktop utility to customize your PS5 DualSense & DualSense Edge RGB lightbar, battery telemetry, dynamic effects, player LEDs, and mic indicator over USB & Bluetooth with zero bloatware.",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libhidapi-hidraw0", "libayatana-appindicator3-1"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
